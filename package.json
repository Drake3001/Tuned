{
  "name": "tuned-gg-monorepo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "prisma generate --config packages/db/prisma.config.ts",
    "db:generate": "prisma generate --config packages/db/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config packages/db/prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config packages/db/prisma.config.ts",
    "db:studio": "prisma studio --config packages/db/prisma.config.ts",
    "infra:up": "docker compose up -d postgres keycloak",
    "infra:ps": "docker compose ps",
    "format": "prettier --write .",
    "lint": "npm run lint --workspaces",
    "keycloak:reset": "bash scripts/reset-keycloak.sh",
    "keycloak:export": "bash scripts/export-keycloak-realm.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "dotenv": "^17.2.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0"
  }
}
