# Copy to .env and adjust for local development.
POSTGRES_USER=tuned
POSTGRES_PASSWORD=tuned
POSTGRES_DB=tuned
DATABASE_URL="postgresql://tuned:tuned@localhost:5432/tuned?schema=public"

# NextAuth (apps/web) — redirect URI in Keycloak: http://localhost:3000/api/auth/callback/keycloak
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"
AUTH_SECRET="change-me"
AUTH_KEYCLOAK_ID="tuned-app"
AUTH_KEYCLOAK_SECRET="tuned-dev-secret"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/tuned_realm"

KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
KC_REALM=tuned_realm

# WebSocket (apps/ws + apps/web client)
WS_PORT=3001
WS_CORS_ORIGIN="http://localhost:3000"
SOCKET_TOKEN_SECRET="change-me"
NEXT_PUBLIC_WS_URL="http://localhost:3001"
