# Copy to .env and adjust for local development.
POSTGRES_USER=tuned
POSTGRES_PASSWORD=tuned
POSTGRES_DB=tuned
DATABASE_URL="postgresql://tuned:tuned@localhost:5432/tuned?schema=public"

# NextAuth (apps/web) — redirect URI in Keycloak: http://localhost:3000/api/auth/callback/keycloak
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"
AUTH_SECRET="change-me"
AUTH_KEYCLOAK_ID="tuned-app"
AUTH_KEYCLOAK_SECRET="tuned-dev-secret"
# Next.js (server-side) must reach this URL. Start Keycloak: npm run infra:up
AUTH_KEYCLOAK_ISSUER="http://localhost:8081/realms/tuned-realm"
# WSL only: if localhost:8081 refuses connections, try Windows host IP from /etc/resolv.conf (nameserver)

KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# Realm name in Keycloak (must match export filenames: <KC_REALM>-realm.json)
KC_REALM=tuned
